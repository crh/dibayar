# Copy to .env.local for local development. Never commit real values.
# All values below are synthetic placeholders only.

DATABASE_URL="postgresql://user:***@localhost:5432/dibayar_dev?schema=public"
AUTH_SECRET="generate-a-long-random-secret"
AUTH_GOOGLE_ID="google-client-id"
AUTH_GOOGLE_SECRET="google-client-secret"

# Google OAuth redirect URIs:
# Local:      http://localhost:3000/api/auth/callback/google
# Production: https://<approved-domain>/api/auth/callback/google

# Restricted-pilot creator access (src/lib/pilot-access.ts). Unset or
# empty denies every creator sign-in and session (fails closed). Use your
# own Google email locally, or PILOT_ACCESS_MODE="open" for local
# development only ("open" is ignored on Vercel Production).
PILOT_ALLOWED_EMAILS="creator@example.invalid"
# PILOT_ACCESS_MODE="open"
