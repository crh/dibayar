{
  "name": "dibayar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ux-audit": "npm run build && playwright test",
    "test:ux-detectors": "UX_SKIP_WEBSERVER=1 playwright test detectors.selftest.spec.ts",
    "test:ux-baseline": "npm run build && playwright test baseline.landing.spec.ts",
    "ux:fixtures": "tsx scripts/ux-fixtures.ts",
    "e2e:fixtures": "E2E_FIXTURE_CONFIRM=non-production tsx --env-file-if-exists=.env.local scripts/e2e-fixtures.ts",
    "e2e:build": "next build",
    "test:e2e": "npm run e2e:build && playwright test -c playwright.e2e.config.ts --project=chromium --project=chromium-mobile",
    "test:e2e:critical": "npm run e2e:build && playwright test -c playwright.e2e.config.ts --project=chromium --project=chromium-mobile --grep @critical",
    "test:e2e:visual": "npm run e2e:build && playwright test -c playwright.e2e.config.ts --project=chromium --grep @visual",
    "test:e2e:a11y": "npm run e2e:build && playwright test -c playwright.e2e.config.ts --project=chromium --grep @a11y",
    "test:e2e:update-snapshots": "npm run e2e:build && playwright test -c playwright.e2e.config.ts --project=chromium --grep @visual --update-snapshots",
    "test:e2e:all-browsers": "npm run e2e:build && playwright test -c playwright.e2e.config.ts",
    "test:e2e:headed": "playwright test -c playwright.e2e.config.ts --project=chromium --headed",
    "test:e2e:ui": "playwright test -c playwright.e2e.config.ts --ui",
    "test:cron-guard": "node --test scripts/cron-guard.test.mjs",
    "test:lint-wrapper": "node --test scripts/lint.test.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "browserslist": "4.28.7",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "mysql2": "3.23.1",
    "deepmerge-ts": "8.0.2"
  }
}
