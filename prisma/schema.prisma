generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DealStatus {
  MASUK
  NEGO
  DEAL
  KONTEN
  INVOICE
  DIBAYAR
}

enum InvoiceStatus {
  DRAFT
  SENT
  DUE
  OVERDUE
  PAID
}

enum WithholdingTaxType {
  NONE
  PPH21
  PPH23
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  language         String            @default("id")
  accounts         Account[]
  sessions         Session[]
  deals            Deal[]
  invoices         Invoice[]
  invoiceSequences InvoiceSequence[]
  authEvents       AuthEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId      String
  expires     DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deal {
  id           String     @id @default(cuid())
  userId       String
  brand        String
  contactWa    String
  scope        String     @db.Text
  feeIdr       Int
  deadline     DateTime?
  paymentTerms String?    @db.Text
  status       DealStatus @default(MASUK)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, deadline])
}

// Numbered per user per calendar month as INV/YYYY/MM/NNN (Asia/Jakarta boundary).
// See src/lib/invoice-number.ts for the numbering/atomicity contract.
model Invoice {
  id                 String             @id @default(cuid())
  userId             String
  dealId             String
  number             String
  subtotalIdr        Int
  withholdingTaxType WithholdingTaxType @default(NONE)
  status             InvoiceStatus      @default(DRAFT)
  dueDate            DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal               Deal               @relation(fields: [dealId], references: [id], onDelete: Restrict)
  share              InvoiceShare?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([userId, number])
  @@index([dealId])
}

// Recipient share link: tokenHash is a SHA-256 hex digest of a 32-random-byte,
// base64url token. The plaintext token is never persisted — only its hash, so
// a lookup requires re-deriving the hash from a presented token. One row per
// invoice; presence of a row means the link is active (revoke deletes the row).
model InvoiceShare {
  id        String    @id @default(cuid())
  invoiceId String    @unique
  tokenHash String    @unique
  expiresAt DateTime?
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// One row per (user, year, month); lastSequence is incremented atomically
// (INSERT ... ON CONFLICT ... DO UPDATE ... RETURNING) to hand out invoice
// sequence numbers without a race. See src/lib/invoice-number.ts.
model InvoiceSequence {
  id           String   @id @default(cuid())
  userId       String
  year         Int
  month        Int
  lastSequence Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([userId, year, month])
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  provider  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
