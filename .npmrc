; Suppresses npm's own "> pkg@version script\n> command" lifecycle banner on
; stdout. Without this, `npm run <script>`'s stdout always starts with that
; banner ahead of the script's own output, which breaks any caller that
; treats `npm run lint`'s stdout as strict JSON (see scripts/lint.mjs). Child
; process stdout/stderr and exit codes are unaffected -- this only quiets
; npm's own log lines.
loglevel=silent
